# ─── API ──────────────────────────────────────────────────────────────────────
# URL of the xdopestore-api backend (no trailing slash).
# Used server-side (SSR/metadata) — does NOT need the NEXT_PUBLIC_ prefix.
API_PROD_URL=http://localhost:5000

# Same URL exposed to the browser (client-side axios calls).
# Must match API_PROD_URL in most setups.
NEXT_PUBLIC_API_URL=http://localhost:5000
